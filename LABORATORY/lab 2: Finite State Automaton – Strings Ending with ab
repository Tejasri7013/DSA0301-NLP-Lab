def accepts(string):
    state = 0

    for ch in string:
        if state == 0:
            if ch == 'a':
                state = 1
            else:
                state = 0

        elif state == 1:
            if ch == 'a':
                state = 1
            elif ch == 'b':
                state = 2
            else:
                state = 0

        elif state == 2:
            if ch == 'a':
                state = 1
            else:
                state = 0

    return state == 2


strings = ["ab", "aab", "abc", "abab", "helloab", "aba"]

for s in strings:
    if accepts(s):
        print(s, "Accepted")
    else:
        print(s, "Rejected")
