import random

tag_probabilities = {
    "I": {"PRP": 1.0},
    "love": {"VB": 0.8, "NN": 0.2},
    "Python": {"NNP": 1.0},
    "programming": {"NN": 0.6, "VBG": 0.4}
}

sentence = ["I", "love", "Python", "programming"]

for word in sentence:
    probabilities = tag_probabilities[word]

    tags = list(probabilities.keys())
    weights = list(probabilities.values())

    tag = random.choices(tags, weights=weights)[0]

    print(word, "->", tag)
